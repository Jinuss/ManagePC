{
  "name": "SuperSystemMonitor",
  "version": "1.0.19",
  "description": "Super System Monitor",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack:win": "npm run build && electron-builder --config electron-builder.yml --win --x64",
    "pack:mac": "npm run build && electron-builder --config electron-builder.yml --mac --x64",
    "pack:all": "npm run build && electron-builder --config electron-builder.yml -mwl",
    "publish:win": "npm run build && electron-builder --config electron-builder.yml --win --x64 --publish=never",
    "publish:mac": "npm run build && electron-builder --config electron-builder.yml --mac --x64 --publish=never"
  },
  "keywords": [
    "electron",
    "vue",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "echarts": "^6.1.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "naive-ui": "^2.44.1",
    "semver": "^7.8.5",
    "systeminformation": "^5.31.7",
    "vue": "^3.4.21",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^9.14.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.2.8"
  }
}
