{
  "name": "system-monitor",
  "version": "1.0.4",
  "description": "Super System Monitor",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack:win": "npm run build && electron-builder --win --x64",
    "pack:mac": "npm run build && electron-builder --mac --x64",
    "pack:all": "npm run build && electron-builder -mwl",
    "publish": "npm run build && electron-builder --win --x64 --publish=always"
  },
  "build": {
    "appId": "com.example.system-monitor",
    "productName": "Super System Monitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "publish": {
      "provider": "github",
      "repo": "ManagePC",
      "owner": "Jinuss",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/assets/icons/windows/icon.ico"
    },
    "nsis": {
      "installerIcon": "resources/assets/icons/windows/icon.ico",
      "uninstallerIcon": "resources/assets/icons/windows/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    }
  },
  "keywords": [
    "electron",
    "vue",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.9",
    "naive-ui": "^2.44.1",
    "systeminformation": "^5.31.7",
    "vue": "^3.4.21",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^9.14.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "rollup-plugin-copy": "^3.5.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.2.8"
  }
}
