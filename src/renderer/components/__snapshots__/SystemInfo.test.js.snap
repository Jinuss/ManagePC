// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`SystemInfo should match snapshot 1`] = `
"<div class="system-info">
  <h2 class="section-title">📡 网络信息</h2>
  <div class="network-cards">
    <div class="network-card">
      <div class="card-header"><span class="interface-name">Ethernet</span></div>
      <div class="card-body">
        <div class="info-item"><span class="label">IP地址:</span><span class="value ip-value">192.168.1.100</span></div>
        <div class="info-item"><span class="label">MAC地址:</span><span class="value mac-value">AA:BB:CC:DD:EE:FF</span></div>
        <div class="info-item"><span class="label">子网掩码:</span><span class="value">255.255.255.0</span></div>
        <div class="info-item"><span class="label">DHCP:</span><span class="value">是</span></div>
      </div>
    </div>
  </div>
  <h2 class="section-title">🔑 SSH密钥</h2>
  <div class="ssh-card">
    <div class="ssh-content"><pre class="ssh-key">ssh-rsa AAAAB3Nza...</pre>
    </div><button class="copy-btn">复制</button>
  </div>
</div>"
`;
